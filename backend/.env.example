# 服务器配置
HOST=127.0.0.1
PORT=8003

# MinerU API配置
MINERU_BASE_URL=https://mineru.net
MINERU_API_KEY=your_mineru_api_key_here

# 模型配置
BASE_URL=http://localhost:4000
API_KEY=your_api_key_here
EMBEDDING_MODEL=github_copilot/text-embedding-ada-002
DEFAULT_MODEL=gpt-4o

# LiteLLM 429 Fallback 配置
# 在 LiteLLM proxy 的 config.yaml 中配置 fallbacks，无需修改应用代码
# 示例：
#   model_list:
#     - model_name: gpt-4o
#       litellm_params:
#         model: gpt-4o
#     - model_name: gpt-4o              # 同名即 fallback
#       litellm_params:
#         model: gpt-4o-mini            # 备用模型
#   fallbacks:
#     - gpt-4o: ["gpt-4o-mini"]        # 主模型 429 时自动切换

# Milvus配置（两种模式二选一）
# 模式A：Zilliz Cloud（云托管，推荐）- 填下面 MILVUS_URI + MILVUS_TOKEN
# 模式B：本地 Milvus - 留空 MILVUS_URI，用 MILVUS_HOST + MILVUS_PORT
MILVUS_URI=
MILVUS_TOKEN=
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_DB_NAME=default  # Zilliz Cloud Free 强制用 default；本地 Milvus 可用 rag_test

# PostgreSQL配置
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=rag_system

# Elasticsearch配置
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USER=elastic
ELASTICSEARCH_PASSWORD=your_elasticsearch_password_here

# 日志配置
LOG_CONSOLE_LEVEL=20  # INFO级别
LOG_FILE_LEVEL=10  # DEBUG级别

# ── RAG 检索参数 ──────────────────────────────────────────
RETRIEVAL_MIN_SCORE=0.3
RETRIEVAL_TOP_K=5
RRF_K=60                  # 倒数排名融合平滑常数
DEFAULT_RETRIEVAL_MODE=advanced  # native|advanced|hybrid
NUM_SUBQUESTIONS=3         # 查询扩展子问题数 (1-5)
MILVUS_NPROBE=10           # IVF 搜索探针数（越大召回越高越慢）
MILVUS_NLIST=128           # IVF_FLAT 聚类中心数（仅建索引时生效）
MILVUS_METRIC_TYPE=COSINE  # 距离度量: COSINE|L2|IP
EMBEDDING_DIM=1536         # 向量维度（换 embedding 模型需同步，且需重新导入向量）

# ── 文档切分参数 ──────────────────────────────────────────
CHUNK_SIZE=400             # 递归切割器目标 chunk 大小（字符）
CHUNK_OVERLAP=50           # 相邻 chunk 重叠字符数
MIN_CHUNK_SIZE=100         # Markdown 短 chunk 合并阈值
MAX_CHUNK_SIZE=800          # Markdown 长 chunk 二次切割阈值

# ── LLM 温度参数 ──────────────────────────────────────────
LLM_TEMPERATURE_DEFAULT=0.7  # Agent 默认温度
LLM_TEMPERATURE_ANSWER=0.5   # RAG 回答生成温度
LLM_TEMPERATURE_GREETING=0.8 # 问候回答温度
LLM_RERANKER_MAX_TOKENS=200  # LLM Reranker 最大 token

# ── 会话与记忆 ────────────────────────────────────────────
SESSION_MAX_HISTORY=10      # 每会话最大保留轮数
SESSION_CONTEXT_WINDOW=5    # 拼入 prompt 的近期对话轮数

# ── 文档处理 ──────────────────────────────────────────────
LLM_MAX_RETRIES=3           # 文档处理 ChatModel 重试次数
LLM_TIMEOUT=120             # 文档处理 ChatModel 超时（秒）

# ── 追踪配置 ──────────────────────────────────────────────
# 追踪后端选择: phoenix | langfuse | none（默认关闭）
TRACER_BACKEND=none

# Phoenix 配置（TRACER_BACKEND=phoenix 时生效）
# 无需额外配置，Phoenix 本地运行
# 安装: pip install arize-phoenix openinference-instrumentation-langchain
# 启动后访问: http://localhost:6006

# Langfuse 配置（TRACER_BACKEND=langfuse 时生效）
# 自托管: docker run -p 3000:3000 langfuse/langfuse
# 或使用云服务: https://cloud.langfuse.com
# 安装: pip install langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
