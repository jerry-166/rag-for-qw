ror","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/process/result/{file_id}":{"get":{"tags":["processing"],"summary":"Get Process Result","description":"获取文档处理结果","operationId":"get_process_result_api_process_result__file_id__get","security":[{"OAuth2PasswordBearer":[]}],"parameters":[{"name":"file_id","in":"path","required":true,"schema":{"type":"string","title":"File Id"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/milvus/query":{"post":{"tags":["search"],"summary":"Query Milvus","description":"纯向量检索 — 仅使用 Milvus 做语义相似度匹配。\n\n流程: Query → Embedding → Milvus ANN Search → [可选] Rerank → Top-K","operationId":"query_milvus_api_milvus_query_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/QueryRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"OAuth2PasswordBearer":[]}]}},"/api/milvus/info":{"get":{"tags":["search"],"summary":"Get Milvus Info","description":"获取 Milvus 集合信息（仅管理员）。","operationId":"get_milvus_info_api_milvus_info_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}},"security":[{"OAuth2PasswordBearer":[]}]}},"/api/elasticsearch/search":{"post":{"tags":["search"],"summary":"Search Elasticsearch","description":"纯关键词检索 — 使用配置的搜索引擎（BM25 或 ES）做关键词匹配。\n\n流程: Query → Search Match → [可选] Rerank → Top-K","operationId":"search_elasticsearch_api_elasticsearch_search_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/QueryRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"OAuth2PasswordBearer":[]}]}},"/api/hybrid/search":{"post":{"tags":["search"],"summary":"Hybrid Search","description":"混合检索 — 并行调用 ES + Milvus，经 RRF 融合后可选 Rerank 精排。\n\n完整流程:\n  1. 并行召回: ES(关键词) + Milvus(向量·摘要+子问题)\n  2. RRF 融合: 合并多路结果、去重、按排名打分\n  3. 数据补全: 通过 PostgreSQL 获取完整 chunk 内容\n  4. 精排:   可选 Cross-Encoder / LLM 重排序\n  5. 返回:   最终 Top-K 结果","operationId":"hybrid_search_api_hybrid_search_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/QueryRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"OAuth2PasswordBearer":[]}]}},"/api/stats/overview":{"get":{"tags":["stats"],"summary":"Get Stats Overview","description":"获取统计概览","operationId":"get_stats_overview_api_stats_overview_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}},"security":[{"OAuth2PasswordBearer":[]}]}},"/api/agent/list":{"get":{"tags":["agent","agent"],"summary":"List Agents","description":"列出所有已注册的 Agent 类型及其能力\n\n返回示例：\n```json\n{\n  \"agents\": [\n    {\n      \"type\": \"simple\",\n      \"name\": \"SimpleRAGAgent\",\n      \"is_default\": false,\n      \"capabilities\": [\"retrieval\", \"basic-chat\"]\n    },\n    {\n      \"type\": \"advanced\",\n      \"name\": \"AdvancedRAGAgent\",\n      \"is_default\": false,\n      \"capabilities\": [\"intent-classification\", \"entity-extraction\", \"task-planning\", \"tool-call\"]\n    },\n    {\n      \"type\": \"claw\",\n      \"name\": \"ClawRAGAgent\",\n      \"is_default\": true,\n      \"capabilities\": [\"rag-workflow\", \"query-expansion\", \"hybrid-retrieval\", \"rerank\", \"memory\", \"sse-stream\"]\n    }\n  ],\n  \"default\": \"claw\"\n}\n```","operationId":"list_agents_api_agent_list_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}},"security":[{"OAuth2PasswordBearer":[]}]}},"/api/agent/preheat-status":{"get":{"tags":["agent","agent"],"summary":"Agent Preheat Status","description":"查询 Agent 预热状态\n\n返回后台预热线程的状态，前端可根据此状态决定是否显示加载提示。","operationId":"agent_preheat_status_api_agent_preheat_status_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}},"security":[{"OAuth2PasswordBearer":[]}]}},"/api/agent/health":{"get":{"tags":["agent","agent"],"summary":"Agent Health","description":"Agent 服务健康检查\n\n返回各 Agent 的初始化状态和响应时间。\n注意：首次调用会触发对应 Agent 的实例化。","operationId":"agent_health_api_agent_health_get","responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}}},"security":[{"OAuth2PasswordBearer":[]}]}},"/api/agent/chat":{"post":{"tags":["agent","agent"],"summary":"Chat","description":"单 Agent 对话（非流式）\n\n通过 agent_type 参数切换不同的 Agent：\n- simple   → 轻量 Chain Agent\n- advanced → 完整 LangGraph Agent\n- claw     → RAG 专属工作流（默认）\n\n示例请求：\n```json\n{\n  \"query\": \"RAG 技术是什么？\",\n  \"agent_type\": \"claw\",\n  \"knowledge_base_id\": \"kb123\",\n  \"session_id\": \"user123_session1\"\n}\n```","operationId":"chat_api_agent_chat_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChatRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"OAuth2PasswordBearer":[]}]}},"/api/agent/chat/stream":{"post":{"tags":["agent","agent"],"summary":"Chat Stream","description":"流式对话（SSE）\n\n启用 Server-Sent Events 实时推送 Agent 处理进度和回答内容。\n\n事件类型：\n- thinking  → Agent 正在思考\n- intent    → 意图识别结果\n- retrieved → 检索完成\n- reranked  → 精排完成\n- chunk     → 回答内容块\n- error     → 错误信息\n- done      → 流式结束\n\n示例请求：\n```json\n{\n  \"query\": \"RAG 和 Fine-tuning 的区别是什么？\",\n  \"agent_type\": \"claw\",\n  \"stream\": true\n}\n```","operationId":"chat_stream_api_agent_chat_stream_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/ChatRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"OAuth2PasswordBearer":[]}]}},"/api/agent/compare":{"post":{"tags":["agent","agent"],"summary":"Compare Agents","description":"多 Agent 对比模式\n\n同时运行多个 Agent，返回各 Agent 的回答和处理信息，便于横向对比效果。\n\n对比维度：\n- 回答内容质量\n- 处理耗时\n- 意图识别准确性\n- 检索文档数量\n\n示例请求：\n```json\n{\n  \"query\": \"什么是 RAG？\",\n  \"agent_types\": [\"simple\", \"advanced\", \"claw\"]\n}\n```","operationId":"compare_agents_api_agent_compare_post","requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CompareRequest"}}},"required":true},"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}},"security":[{"OAuth2PasswordBearer":[]}]}},"/api/agent/session/{session_id}/history":{"get":{"tags":["agent","agent"],"summary":"Get Session History","description":"获取会话历史\n\n支持 ClawAgent 的会话历史查询。","operationId":"get_session_history_api_agent_session__session_id__history_get","security":[{"OAuth2PasswordBearer":[]}],"parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}},{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":20,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/agent/sessions":{"get":{"tags":["agent","agent"],"summary":"List All Sessions","description":"列出所有历史会话（按更新时间降序）\n\n返回 sessions/ 目录下所有 .json 会话文件的摘要信息。","operationId":"list_all_sessions_api_agent_sessions_get","security":[{"OAuth2PasswordBearer":[]}],"parameters":[{"name":"limit","in":"query","required":false,"schema":{"type":"integer","default":50,"title":"Limit"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/agent/session/{session_id}":{"delete":{"tags":["agent","agent"],"summary":"Delete Or Clear Session","description":"清空或删除指定会话\n\n- 无 action 参数（或 action=clear）：清空会话的所有历史消息，保留会话文件\n- action=delete：彻底删除会话文件（不可恢复）","operationId":"delete_or_clear_session_api_agent_session__session_id__delete","security":[{"OAuth2PasswordBearer":[]}],"parameters":[{"name":"session_id","in":"path","required":true,"schema":{"type":"string","title":"Session Id"}},{"name":"action","in":"query","required":false,"schema":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Action"}}],"responses":{"200":{"description":"Successful Response","content":{"application/json":{"schema":{}}}},"422":{"description":"Validation Error","content":{"application/json":{"schema":{"$ref":"#/components/schemas/HTTPValidationError"}}}}}}},"/api/agent/feedback":{"post":{"tags":["agent","agent"],"summary":"Submit Feedback","description":"提交消息反馈（点赞 / 点踩）并同步到 Langfuse\n\n将用户反馈以 Score 形式写入 Langfuse，可在 Langfuse UI 的 Traces 和 Sessions 中查看。\n\n- value=1 → 正向反馈（👍）\n- value=0 → 负向反馈（👎）\n\ntrace_id 优先使用前端传来