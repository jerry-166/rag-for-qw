<node id="Cache Eviction Storm">
  <data key="d0">Cache Eviction Storm</data>
  <data key="d1">event</data>
  <data key="d2">A common issue in query rewriting systems where a sudden invalidation of cached data leads to system instability and increased load.&lt;SEP&gt;A potential problem in the Document Slicing Strategy caused by widespread invalidation or removal of cached data.</data>
  <data key="d3">doc-979d472a84804b9f647bc185a877a8b5-chunk-000&lt;SEP&gt;doc-85d8ce590ad8981ca2c8286f79f59954-chunk-000</data>
  <data key="d4">213&lt;SEP&gt;197</data>
  <data key="d5">1788256131</data>
  <data key="d6"></data>
</node>
<node id="Connection Pool Depletion">
  <data key="d0">Connection Pool Depletion</data>
  <data key="d1">concept</data>
  <data key="d2">A condition in query rewriting systems where all available connections are exhausted, causing performance degradation.</data>
  <data key="d3">doc-979d472a84804b9f647bc185a877a8b5-chunk-000</data>
  <data key="d4">213</data>
  <data key="d5">1788255924</data>
