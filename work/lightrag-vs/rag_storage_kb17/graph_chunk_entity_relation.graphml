</node>
<node id="High Latency Round Trip">
  <data key="d0">High Latency Round Trip</data>
  <data key="d1">concept</data>
  <data key="d2">An issue in remote service interactions, often highlighted in query rewriting systems, where network delays significantly impact system performance.</data>
  <data key="d3">doc-979d472a84804b9f647bc185a877a8b5-chunk-000</data>
  <data key="d4">213</data>
  <data key="d5">1788255924</data>
