# ===================================================================
# RAG System 生产环境变量模板
# ===================================================================
# 使用方法：
#   1. 复制此文件: cp .env.production.example .env.production
#   2. 生成强密码（推荐用 openssl）：
#      openssl rand -hex 24    # 生成 48 位十六进制密码
#   3. 逐项修改下方所有 [必须修改] 标记的值
#   4. 启动: docker compose --env-file .env.production up -d
#   5. 切勿将 .env.production 提交到 git！
# ===================================================================

# ── 应用安全（[必须修改]）──────────────────────────────────────
# JWT 加密密钥，原代码里是弱密钥 lrj669761379123，必须换！
# 生成: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_TO_RANDOM_64_HEX_STRING

# Token 过期时间（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── PostgreSQL 数据库（[必须修改]）──────────────────────────────
POSTGRES_USER=raguser
# 生成: openssl rand -hex 16
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_DB_PASSWORD
POSTGRES_DB=rag_system

# ── MinIO 对象存储（Milvus 后端）（[必须修改]）─────────────────
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# ── LiteLLM Proxy（[必须修改]）──────────────────────────────────
# Master Key，用于管理 LiteLLM 和调用 API
# 生成: openssl rand -hex 24
LITELLM_MASTER_KEY=sk-litellm-CHANGE_ME
# Salt Key，用于加密存储的 API key
# 生成: openssl rand -hex 24
LITELLM_SALT_KEY=CHANGE_ME_SALT_KEY

# ── Milvus 配置 ──────────────────────────────────────────────
MILVUS_DB_NAME=default  # Zilliz Cloud Free 强制用 default；本地 Milvus 可用 rag_system

# ── Zilliz Cloud 配置（云托管 Milvus，推荐）───────────────
# Public Endpoint（从 Zilliz Cloud 控制台 → Cluster 详情页复制）
MILVUS_URI=https://in03-CHANGE_ME.serverless.aws-eu-central-1.zillizcloud.com
# API Token（控制台 → API Keys → Create API Key 生成）
MILVUS_TOKEN=CHANGE_ME_TO_ZILLIZ_CLOUD_TOKEN
# 设置 MILVUS_URI 后，milvus_client.py 自动用 Zilliz Cloud 模式
# 留空则 fallback 到本地 Milvus（需要再起 etcd + minio + milvus 三个容器）

# ── 外部 API 密钥（[必须修改]）──────────────────────────────────
# OpenAI API Key（gpt-4o / gpt-4o-mini）
OPENAI_API_KEY=sk-your-openai-key-here

# GitHub Copilot API Key（embedding 模型用）
GITHUB_COPILOT_API_KEY=your-github-copilot-key-here

# MinerU 文档解析 API
MINERU_API_KEY=your-mineru-api-key-here

# ── 模型配置 ──────────────────────────────────────────────────
EMBEDDING_MODEL=github_copilot/text-embedding-ada-002
DEFAULT_MODEL=gpt-4o

# ── 追踪（可选，默认关闭省内存）──────────────────────────────────
# none=关闭 | langfuse=用 Langfuse | phoenix=用 Phoenix
TRACER_BACKEND=none

# 如启用 Langfuse，填以下配置（否则忽略）
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ===================================================================
# 安全检查清单（部署前逐项确认）：
# [ ] SECRET_KEY 已从弱密钥替换为 64 位随机串
# [ ] POSTGRES_PASSWORD 已设置为强密码（非默认值）
# [ ] MINIO_ROOT_PASSWORD 已设置为强密码（非 minioadmin）
# [ ] LITELLM_MASTER_KEY 已设置为强随机串
# [ ] .env.production 已加入 .gitignore
# [ ] 所有端口（5432/4000/19530/8003）只绑 127.0.0.1
# [ ] 服务器 SSH 已改为密钥登录、禁用 root
# [ ] 防火墙只开放 80/443/22 端口
# ===================================================================
